---
import Page from '../../layouts/Page.astro';
import Icon from '../../components/Icon.astro';
import { editions, dateLabel, href } from '../../lib/editions';
---
<Page title="The archive" mode="news"><section class="archive"><h1>Yesterday is<br /><em>still worth reading.</em></h1><p>Every edition, in its own time.</p>{editions.length ? <ol class="archive-list">{editions.map(e => <li><time datetime={e.date}>{dateLabel(e.date)}{e.demo ? ' · Demo' : ''}</time><div><h2><a href={href(`news/${e.date}/`)}>{e.content.title}</a></h2><p>{e.content.articles.length} {e.content.articles.length === 1 ? 'story' : 'stories'}{e.content.lessons.length > 0 && ` · ${e.content.lessons.length} ${e.content.lessons.length === 1 ? 'lesson' : 'lessons'}`}</p></div><a href={href(`radio/${e.date}/`)} aria-label={`Radio edition for ${dateLabel(e.date)}`}><Icon name="headphones" /> Radio</a><a href={href(`news/${e.date}/`)} aria-label={`Read the edition for ${dateLabel(e.date)}`}><Icon name="arrow" /></a></li>)}</ol> : <div class="empty-state"><h2>The archive starts with the first edition.</h2><p>Once published, every newspaper will stay accessible here.</p></div>}</section></Page>
