---
import type { Article, Edition } from '../lib/types';
import Sources from './Sources.astro';
interface Props { article: Article; edition: Edition; lead?: boolean; brief?: boolean }
const { article, edition, lead = false, brief = false } = Astro.props;
const Heading = brief ? 'h4' : 'h2';
---
<article class:list={['story', { 'lead-story': lead, 'brief-story': brief, 'long-headline': article.headline.length > 100 }]} id={article.id}>
  <header class="story-heading">
  <Heading>{article.headline}</Heading>
  <div class="story-meta"><span>{article.section}</span><span>{article.source_ids.length} {article.source_ids.length === 1 ? 'source' : 'sources'}</span></div>
  <p class="story-summary">{article.summary}</p>
  </header>
  <div class="story-copy">
  <div class="story-body">{article.paragraphs.map(p => <p>{p}</p>)}</div>
  <p class="implication"><strong>Our take.</strong> {article.implication}</p>
  <Sources ids={article.source_ids} sources={edition.sources} demo={edition.demo} showDates />
  </div>
</article>
