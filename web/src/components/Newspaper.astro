---
import Page from '../layouts/Page.astro';
import Story from './Story.astro';
import Sources from './Sources.astro';
import Quiz from './Quiz.astro';
import Icon from './Icon.astro';
import { dateLabel, weekday, href, readingMinutes, today } from '../lib/editions';
import type { Edition } from '../lib/types';
interface Props { edition?: Edition; isLatest?: boolean }
const { edition, isLatest = false } = Astro.props;
const [lead, ...rest] = edition?.content.articles ?? [];
---
<Page title={edition ? `${dateLabel(edition.date)} · Newspaper` : 'The newspaper'} mode="news" edition={edition}>
  <section class="masthead" aria-label="Daywire newspaper"><p>Independent curiosity.<br />A daily perspective.</p><a href={href('news/')} class="masthead-name">Daywire<span>.</span></a><p>Read the news.<br />Keep the understanding.</p></section>
  {edition ? <>
    <div class="edition-line"><span>{weekday(edition.date)}, {dateLabel(edition.date)}</span><span>{edition.content.articles.length} stories · Two things to learn</span><span>About {readingMinutes(edition)} min to read</span></div>
    {isLatest && edition.date !== today && !edition.demo && <p class="coverage-note">The latest available edition is dated {dateLabel(edition.date)}. A newer edition has not been published.</p>}
    <div class="edition-intro"><p>{edition.content.introduction}</p><a href={href(`radio/${edition.date}/`)}>Take it with you <Icon name="headphones" /></a></div>
    <nav class="contents-nav" aria-label="In this edition"><span>Inside this edition</span><a href="#top-stories">The front page</a><a href="#learn">Learn two things</a><a href="#quiz">Quick recall</a><a href="#coverage">Sources & coverage</a></nav>
    <section id="top-stories" class="front-page" aria-label="Top stories">
      <div class="lead-column">{lead && <Story article={lead} edition={edition} lead />}</div>
      <div class="supporting-column">{rest.slice(0, 2).map(article => <Story article={article} edition={edition} />)}
        {!rest.length && <aside class="quiet-day"><h2>A shorter edition.</h2><p>One supported story is worth more than a page of filler.</p><a href="#learn">Go deeper in the learning section <Icon name="arrow" /></a></aside>}
      </div>
    </section>
    {rest.length > 2 && <section class="more-stories" aria-label="More from this edition">{rest.slice(2).map(article => <Story article={article} edition={edition} />)}</section>}
    <section class="learning-section" id="learn" aria-labelledby="learn-heading">
      <div class="section-heading"><h2 id="learn-heading">Leave knowing more.</h2><p>Two ideas behind the headlines.</p></div>
      <div class="lesson-grid">{edition.content.lessons.map((lesson, index) => <article class="lesson" id={lesson.id}>
        <h3>{lesson.title}</h3><p class="lesson-number">Lesson {index + 1} · From this edition</p>
        {lesson.paragraphs.map(p => <p>{p}</p>)}<pre class="lesson-example"><code>{lesson.example}</code></pre>
        <p class="takeaway"><strong>Keep this.</strong> {lesson.takeaway}</p><Sources ids={lesson.source_ids} sources={edition.sources} demo={edition.demo} />
      </article>)}</div>
    </section>
    <Quiz edition={edition} />
    <section class="coverage-section" id="coverage" aria-labelledby="coverage-heading"><h2 id="coverage-heading">The notes behind the newspaper.</h2><div><p>This edition draws on {edition.sources.length} source documents selected from {edition.coverage.candidate_count} candidates. It covers a curated set of sources, not every technology story.</p><p>Collection window: {dateLabel(edition.coverage.from.slice(0, 10))} to {dateLabel(edition.coverage.until.slice(0, 10))}.</p>{edition.sources.some(source => source.published_at && new Date(source.published_at) < new Date(edition.coverage.from)) && <p>Includes earlier coverage. Original publication dates are shown beside the sources.</p>}{edition.coverage.status === 'partial' && <p class="coverage-note">Partial coverage: {edition.coverage.unavailable_sources.length} source or article fetches were unavailable. The edition includes only material successfully retrieved.</p>}<p>AI-assisted writing is checked against retrieved evidence. Those checks can miss errors; original sources remain the reference.</p></div></section>
  </> : <section class="empty-state"><h1>The first edition is on its way.</h1><p>A daily selection of technology stories, two useful ideas, and a radio bulletin. Published editions will appear here with their actual dates.</p><a href={href('news/archive/')}>Visit the archive <Icon name="arrow" /></a></section>}
</Page>
