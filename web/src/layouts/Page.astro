---
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/public-sans';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { editions, dateLabel, weekday, href, editionHref } from '../lib/editions';
import type { Edition } from '../lib/types';
interface Props { title: string; mode: 'news' | 'radio'; edition?: Edition }
const { title, edition } = Astro.props;
const mode = Astro.url.pathname.split('/').includes('radio') ? 'radio' : 'news';
const currentIndex = edition ? editions.findIndex(e => e.date === edition.date) : -1;
const older = currentIndex >= 0 ? editions[currentIndex + 1] : undefined;
const newer = currentIndex > 0 ? editions[currentIndex - 1] : undefined;
const recentEditions = editions.slice(0, 30);
const pickerEditions = edition && currentIndex >= 30 ? [...recentEditions, edition] : recentEditions;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A daily technology newspaper. Read what matters, learn two things, or take the edition with you on the radio." />
    <meta name="theme-color" content="#171916" />
    {edition?.demo && <meta name="robots" content="noindex, nofollow" />}
    <title>{title} — Daywire</title>
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <script is:inline>
      try { const theme = localStorage.getItem('daywire-theme'); if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme; } catch {}
    </script>
  </head>
  <body data-mode={mode}>
    <a class="skip-link" href="#main">Skip to the edition</a>
    <div class="page-shell">
      <header class="site-header">
        <a class="wordmark" href={href('')} aria-label="Daywire home">daywire<span aria-hidden="true">.</span></a>
        <nav class="mode-nav" aria-label="Read or listen">
          <a href={editionHref('news', edition?.date)} aria-current={mode === 'news' ? 'page' : undefined}>Newspaper</a>
          <a href={editionHref('radio', edition?.date)} aria-current={mode === 'radio' ? 'page' : undefined}>Radio <Icon name="headphones" size={17} /></a>
        </nav>
        <div class="edition-controls">
          <details class="date-picker">
            <summary aria-controls="edition-dates">
              <Icon name="calendar" size={17} />
              <span>{edition ? dateLabel(edition.date) : 'Choose an edition'}</span>
              <Icon name="chevron" size={14} />
            </summary>
            <nav id="edition-dates" aria-label="Edition dates">
              <p class="date-menu-title">Choose an edition</p>
              <div class="date-options">
                {pickerEditions.length ? pickerEditions.map(e => (
                  <a class="date-option" href={href(`${mode}/${e.date}/`)} aria-current={e.date === edition?.date ? 'date' : undefined}>
                    <span><time datetime={e.date}>{dateLabel(e.date)}</time><span class="date-option-meta">{weekday(e.date)}{e.demo ? ' · Demo' : ''}</span></span>
                    {e.date === edition?.date && <Icon name="check" size={17} />}
                  </a>
                )) : <p class="date-empty">No editions published yet.</p>}
              </div>
              <a class="date-archive" href={href('news/archive/')}>Browse the archive <Icon name="arrow" size={16} /></a>
            </nav>
          </details>
          <button class="theme-toggle" type="button" aria-label="Switch to light theme" hidden>
            <span class="theme-dark"><Icon name="moon" size={17} /><span>Dark</span></span>
            <span class="theme-light"><Icon name="sun" size={17} /><span>Light</span></span>
          </button>
        </div>
      </header>
      {edition?.demo && <aside class="demo-notice">Demonstration edition · The stories and sources below are fictional examples.</aside>}
      <main id="main"><slot /></main>
      {edition && (older || newer) && <nav class="edition-pager" aria-label="Previous and next editions">
        {older && <a class="previous-edition" href={href(`${mode}/${older.date}/`)}><Icon name="arrow" size={16} /> <span>Previous edition · {dateLabel(older.date)}</span></a>}
        {newer && <a class="next-edition" href={href(`${mode}/${newer.date}/`)}><span>Next edition · {dateLabel(newer.date)}</span> <Icon name="arrow" size={16} /></a>}
      </nav>}
      <footer class="site-footer"><a class="wordmark" href={href('')}>daywire<span>.</span></a><p>New edition daily, around 6am.</p><a href={href('news/archive/')}>Browse the archive <Icon name="arrow" size={16} /></a><p class="footer-note">AI-assisted reporting. Sources beside every story.</p></footer>
    </div>
    <script>
      const picker = document.querySelector<HTMLDetailsElement>('.date-picker');
      if (picker) {
        const closePicker = () => { picker.open = false; };
        document.addEventListener('pointerdown', (event) => {
          if (event.target instanceof Node && !picker.contains(event.target)) closePicker();
        });
        document.addEventListener('click', (event) => {
          if (!(event.target instanceof Element)) return;
          if (!picker.contains(event.target) || event.target.closest('a')) closePicker();
        });
        document.addEventListener('focusin', (event) => {
          if (event.target instanceof Node && !picker.contains(event.target)) closePicker();
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && picker.open) {
            closePicker();
            picker.querySelector('summary')?.focus();
          }
        });
        window.addEventListener('pageshow', closePicker);
      }

      const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
      if (button) {
        button.hidden = false;
        const label = () => {
          const action = `Switch to ${document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'} theme`;
          button.setAttribute('aria-label', action);
          button.title = action;
        };
        label();
        button.addEventListener('click', () => { const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; document.documentElement.dataset.theme = theme; try { localStorage.setItem('daywire-theme', theme); } catch {} label(); });
      }
    </script>
  </body>
</html>
