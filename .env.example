# Export these yourself or configure GitHub Actions secrets. Daywire does not
# automatically load .env, and credentials never enter Astro's public bundle.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Local CPU narration; no speech API key or subscription needed.
TTS_PROVIDER=kokoro
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
# Optional local Apple Silicon acceleration: mps. CI always uses cpu.
KOKORO_DEVICE=cpu
KOKORO_PYTHON=.venv-kokoro/bin/python

# Optional paid provider, used ONLY with TTS_PROVIDER=elevenlabs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# A DIFFERENT bucket, with public access disabled. Contains private evidence.
R2_STATE_BUCKET=
MEDIA_PUBLIC_URL=

# Build-time website settings. Set BASE_PATH=/daywire for project GitHub Pages.
SITE_URL=
BASE_PATH=/
# DAYWIRE_DEMO=1
# DAYWIRE_CONTENT_DIR=content/editions
